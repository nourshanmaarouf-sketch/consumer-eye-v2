rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function approved(id) { return get(/databases/$(db)/documents/shops/$(id)).data.status == 'approved'; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /admins/{id} {
      allow get: if signed() && request.auth.uid == id;
      allow write: if false;
    }

    match /shops/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signed() && request.auth.uid == id);
      allow create: if signed() && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['role','shop','hood','lat','lng','status','created'])
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['retail','wholesale']
        && request.resource.data.shop is string && request.resource.data.shop.size() <= 80;
      allow update: if isAdmin() && onlyChanged(['status','why']) && (!('why' in request.resource.data) || request.resource.data.why.size() <= 200);
    }

    match /private/{id} {
      allow read: if isAdmin() || (signed() && request.auth.uid == id);
      allow create: if signed() && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['phone','own','act','reg']);
    }

    match /items/{id} {
      allow read: if true;
      allow create, update: if signed()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.barcode
        && approved(request.auth.uid)
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.h is list && request.resource.data.h.size() <= 200
        && request.resource.data.h[request.resource.data.h.size() - 1].p == request.resource.data.price
        && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      allow delete: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
    }

    match /complaints/{id} {
      allow read: if isAdmin();
      allow create: if id.matches('^B[0-9A-Z]{6,12}$')
        && request.resource.data.id == id
        && request.resource.data.s == 'new'
        && request.resource.data.keys().hasOnly(['id','t','sh','d','s','at'])
        && request.resource.data.d is string && request.resource.data.d.size() <= 1000
        && request.resource.data.sh is string && request.resource.data.sh.size() <= 100;
      allow update: if isAdmin() && onlyChanged(['s']);
    }

    match /tracking/{id} {
      allow get: if true;
      allow create: if id.matches('^B[0-9A-Z]{6,12}$') && request.resource.data.keys().hasOnly(['s']) && request.resource.data.s == 'new';
      allow update: if isAdmin();
    }

    match /appRatings/{id} {
      allow get: if signed() && request.auth.uid == id;
      allow list: if isAdmin();
      allow create, update: if signed() && request.auth.uid == id
        && request.resource.data.uid == id
        && request.resource.data.keys().hasOnly(['uid','stars','c','at'])
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.c is string && request.resource.data.c.size() <= 140;
      allow delete: if isAdmin();
    }
  }
}
